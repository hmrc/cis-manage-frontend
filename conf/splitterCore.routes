# microservice specific routes

# The bare entry point has no path, so it is not matched by /*path below (that needs at least one character).
# It is the urls.loginContinue target for users returning from login, so it must reach the splitter.
# Must stay above /*path. Remove with the rest of the splitter after private beta.
GET        /                       controllers.splitter.core.SplitterCoreController.coreLandingPage(path = "")
GET        /*path                  controllers.splitter.core.SplitterCoreController.coreLandingPage(path)
